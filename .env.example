# Copy to .env and replace paths for the local machine.
# Load before starting Dora: set -a; source .env; set +a
FSD_ASSETS_DIR=/absolute/path/to/fsd-simverify/assets
ACADOS_SOURCE_DIR=/absolute/path/to/fsd-simverify/simulation-env/acados
ISAAC_SIM_PYTHON_SH=/home/zhz/isaacsim/python.sh
ISAAC_LD_LIBRARY_PATH=/home/zhz/isaacsim/kit/python/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/cuda-13.1/lib64
ORT_DYLIB_PATH=/home/zhz/isaacsim/kit/python/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.so.1.27.0
UV_CACHE_DIR=/home/zhz/.cache/uv_clean
PIDNET_MODEL_PATH=model/pidnet_s.onnx
XFEAT_MODEL_PATH=model/xfeat_640x640.onnx
PHASE2_PROBE_OUTPUT=/home/zhz/fsd-simverify/artifacts/phase2_probe
LD_LIBRARY_PATH=/absolute/path/to/fsd-simverify/simulation-env/acados/lib:/absolute/path/to/fsd-simverify/simulation-env/c_generated_code
